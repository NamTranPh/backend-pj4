SERVER_PORT=3004
# DB (chạy trên máy dùng localhost + port publish; chạy trong docker sẽ override DB_HOST/DB_PORT)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=movie_db
DB_USERNAME=root
DB_PASSWORD=your_password

# JWT
JWT_SECRET=replace-with-at-least-32-characters-secret
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000
JWT_ISSUER=http://localhost:3004
JWT_ENABLE_BEARER_FALLBACK=true

# Auth cookies
AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_PATH=/
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_ADMIN_REFRESH_COOKIE_NAME=admin_refresh_token
AUTH_ADMIN_REFRESH_COOKIE_PATH=/api/v1/admin/auth

# OTP
AUTH_OTP_LENGTH=6
AUTH_OTP_TTL_MINUTES=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_PEPPER=replace-with-otp-pepper

# Login lock
AUTH_LOGIN_MAX_FAILURES=6
AUTH_LOGIN_FAILURE_WINDOW_MINUTES=10
AUTH_LOGIN_LOCK_MINUTES=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_KEY_PREFIX=backend-pj4

# MinIO
# Chạy trên máy: localhost:9000. Chạy docker sẽ override MINIO_ENDPOINT=http://minio:9000
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET_RAW=movie-raw
MINIO_BUCKET_PROCESSED=movie-processed
MINIO_BUCKET_PUBLIC=movie-public
MINIO_BUCKET_AVATAR=avatars

# Multipart configuration (video upload limits)
MULTIPART_MAX_FILE_SIZE=5000MB
MULTIPART_MAX_REQUEST_SIZE=5000MB

# Mail
# Mặc định của Google SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587 
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME="Hệ Thống Xem Phim"
MAIL_FROM_ADDRESS=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PayOS
PAYOS_CLIENT_ID=change-me
PAYOS_API_KEY=change-me
PAYOS_CHECKSUM_KEY=change-me
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=http://localhost:5173/payment/success
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel
# 1. Reconcile - job polling PayOS mỗi 5 phút check đơn PENDING, phòng webhook miss 
#(đặc biệt quan trọng khi dev local vì webhook không gọi được localhost)
#2. Payment link TTL — đơn PENDING quá lâu tự hết hạn + cancel
PAYOS_PAYMENT_LINK_TTL_MINUTES=15
PAYOS_RECONCILE_INTERVAL_MS=300000
PAYOS_RECONCILE_BATCH_LIMIT=100
PAYOS_RECONCILE_LOOKBACK_HOURS=720

# Playback (HLS streaming token)
PLAYBACK_TOKEN_SECRET=replace-with-playback-secret
PLAYBACK_TOKEN_TTL_SECONDS=300
